{
	"mcpServers": {
		"research-zotero": {
			"command": "uvx",
			"args": ["--from", "zotero-mcp-server==0.14.0", "zotero-mcp", "serve"],
			"env": {
				"ZOTERO_LOCAL": "true",
				"ZOTERO_LIBRARY_TYPE": "user",
				"ZOTERO_MCP_TOOLSETS": "none"
			},
			"description": "Zotero library (zotero-mcp-server, https://github.com/54yyyu/zotero-mcp, MIT)",
			"excludeTools": ["zotero_delete_item", "zotero_delete_collection", "zotero_delete_annotation"]
		},
		"research-obsidian": {
			"command": "node",
			"args": ["<path-to-mcpvault-server.js>", "<independent-vault-path>"],
			"vaultWritePolicy": "managed-block-only"
		}
	}
}
