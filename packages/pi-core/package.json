{
	"name": "@gyoungwe/pi-core",
	"version": "0.1.9",
	"description": "Portable task, authorization, status, delivery and memory tools for native Pi",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Gyoungwe/Drone.git",
		"directory": "packages/pi-core"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"files": [
		"dist",
		"skills",
		"package.json",
		"README.md",
		"build-manifest.json"
	],
	"pi": {
		"extensions": [
			"./dist/index.mjs"
		],
		"skills": [
			"./skills/*"
		]
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./host": {
			"types": "./src/host.ts",
			"import": "./dist/host.mjs",
			"default": "./dist/host.mjs"
		},
		"./tools/*": "./src/tools/*.ts",
		"./memory": "./src/memory.ts"
	},
	"scripts": {
		"build": "node ../../scripts/build-pi-core.mjs",
		"build:check": "node ../../scripts/build-pi-core.mjs --check",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test test/*.test.mjs",
		"check": "npm run typecheck && npm run build:check && node ../../scripts/smoke-pi-core.mjs && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0 <2.0.0"
	},
	"dependencies": {
		"@gyoungwe/plugin-api": "*"
	},
	"devDependencies": {
		"@drone/shared": "*",
		"@drone/tasks": "*",
		"typebox": "1.3.7",
		"typescript": "^5.9.0"
	}
}
