{
	"name": "@gyoungwe/pi-analysis",
	"version": "0.1.0",
	"description": "Portable scientific analysis adapters and readiness gates for native Pi",
	"keywords": [
		"pi-package",
		"analysis",
		"bioinformatics"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Gyoungwe/Drone.git",
		"directory": "packages/pi-analysis"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"files": [
		"dist",
		"package.json",
		"README.md",
		"build-manifest.json",
		"plugin.manifest.json"
	],
	"pi": {
		"extensions": [
			"./dist/index.mjs"
		]
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "node ../../scripts/build-pi-analysis.mjs",
		"build:check": "node ../../scripts/build-pi-analysis.mjs --check",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test test/registration.test.mjs",
		"check": "npm run typecheck && npm run build:check && node ../../scripts/smoke-pi-analysis.mjs && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0 <2.0.0"
	},
	"devDependencies": {
		"@gyoungwe/plugin-api": "*",
		"typescript": "^5.9.0"
	}
}
