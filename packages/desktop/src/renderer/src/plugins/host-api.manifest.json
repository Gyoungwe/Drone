			{
				"name": "registerMessages",
				"hostValue": "registerPluginMessages",
				"envType": "typeof registerPluginMessages",
				"pluginType": "(\nnamespace: string,\nmessages: { zh?: Record<string, unknown>; en?: Record<string, unknown> },\n) => () => void"
