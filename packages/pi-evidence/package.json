{
	"name": "@gyoungwe/pi-evidence",
	"version": "0.1.0",
	"description": "Portable evidence manifests, provenance, checkpoints and replay proofs for native Pi",
	"keywords": [
		"pi-package",
		"evidence",
		"provenance",
		"reproducibility"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Gyoungwe/Drone.git",
		"directory": "packages/pi-evidence"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"files": [
		"dist",
		"src",
		"package.json",
		"README.md",
		"build-manifest.json",
		"plugin.manifest.json"
	],
	"pi": {
		"extensions": [
			"./dist/index.mjs"
		]
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "node ../../scripts/build-pi-evidence.mjs",
		"build:check": "node ../../scripts/build-pi-evidence.mjs --check",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test test/registration.test.mjs test/contracts.test.mjs",
		"check": "npm run typecheck && npm run build:check && npm test && node ../../scripts/smoke-pi-evidence.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0 <2.0.0"
	},
	"dependencies": {
		"@gyoungwe/plugin-api": "^1.0.0"
	},
	"devDependencies": {
		"typescript": "^5.9.0"
	}
}
