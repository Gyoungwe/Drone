{
	"name": "@gyoungwe/plugin-api",
	"version": "1.3.0",
	"description": "Stable host contracts for Drone capability plugins",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Gyoungwe/Drone.git",
		"directory": "packages/plugin-api"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./knowledge": {
			"types": "./dist/knowledge.d.ts",
			"import": "./dist/knowledge.js",
			"default": "./dist/knowledge.js"
		},
		"./ui": {
			"types": "./dist/ui.d.ts",
			"import": "./dist/ui.js",
			"default": "./dist/ui.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js",
			"default": "./dist/runtime.js"
		},
		"./native": {
			"types": "./dist/native.d.ts",
			"import": "./dist/native.js",
			"default": "./dist/native.js"
		},
		"./resource": {
			"types": "./dist/resource.d.ts",
			"import": "./dist/resource.js",
			"default": "./dist/resource.js"
		},
		"./research": {
			"types": "./dist/research.d.ts",
			"import": "./dist/research.js",
			"default": "./dist/research.js"
		},
		"./tasks": {
			"types": "./dist/tasks.d.ts",
			"import": "./dist/tasks.js",
			"default": "./dist/tasks.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"scripts": {
		"build": "node ../../scripts/generate-knowledge-ui-contract.mjs --check && tsc -p tsconfig.build.json",
		"typecheck": "node ../../scripts/generate-knowledge-ui-contract.mjs --check && tsc -p tsconfig.json --noEmit",
		"check": "npm run typecheck && npm run build && node ../../scripts/check-plugin-api.mjs --package-only",
		"test": "npm run check && node --test test/*.test.mjs"
	},
	"peerDependencies": {
		"@types/react": ">=19",
		"@earendil-works/pi-coding-agent": ">=1.1.0 <2.0.0"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	}
}
