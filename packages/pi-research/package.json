{
	"name": "@gyoungwe/pi-research",
	"version": "0.1.1",
	"description": "Evidence-gated research retrieval, reading, deposition and source-grounded answer tools for native Pi",
	"keywords": [
		"pi-package",
		"research",
		"evidence"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Gyoungwe/Drone.git",
		"directory": "packages/pi-research"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"files": [
		"dist",
		"skills",
		"package.json",
		"README.md",
		"build-manifest.json"
	],
	"pi": {
		"extensions": [
			"./dist/index.mjs"
		],
		"skills": [
			"./skills/*"
		]
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "node ../../scripts/build-pi-research.mjs",
		"build:check": "node ../../scripts/build-pi-research.mjs --check",
		"typecheck": "tsc --noEmit",
		"test": "node ../../scripts/smoke-pi-research.mjs --fixture-only",
		"check": "npm run typecheck && npm run build:check && npm test"
	},
	"dependencies": {
		"pdfjs-dist": "6.3.289"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0 <2.0.0"
	},
	"devDependencies": {
		"@drone/extensions": "*",
		"@drone/research": "*",
		"typescript": "^5.9.0"
	}
}
