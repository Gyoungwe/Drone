{
	"schemaVersion": 1,
	"id": "drone-pi-connectors",
	"version": "0.1.0",
	"pi": {
		"apiVersion": 1,
		"minHostVersion": "1.1.0",
		"testedHosts": ["1.1.0", "latest"]
	},
	"drone": {
		"pluginApi": 1,
		"resultContract": "drone-result/v3"
	},
	"entrypoints": {
		"extension": "./dist/index.mjs"
	},
	"capabilities": ["connectors", "read-only", "provenance-receipts"],
	"hosts": ["native-pi", "drone-desktop"],
	"permissions": {
		"filesystem": [],
		"network": ["host-declared connector endpoints"],
		"credentials": ["opaque host-supplied references only"],
		"readWrite": {
			"read": true,
			"write": false,
			"delete": false
		},
		"externalWrites": false,
		"externalSideEffects": []
	},
	"connectorDeclarations": [
		{
			"id": "zotero",
			"readOnly": true,
			"network": "public:api.zotero.org",
			"credentials": "optional host-secret-store/environment",
			"externalSideEffects": []
		},
		{
			"id": "webdav",
			"readOnly": true,
			"network": "configured endpoint",
			"credentials": "required host-secret-store/environment",
			"externalSideEffects": []
		},
		{
			"id": "generic-mcp",
			"readOnly": true,
			"network": "host-configured endpoint",
			"credentials": "optional mcp-config/host-secret-store",
			"externalSideEffects": []
		},
		{
			"id": "institutional",
			"readOnly": true,
			"network": "configured institutional host",
			"credentials": "required browser-session/oauth",
			"externalSideEffects": ["browser-navigation"]
		},
		{
			"id": "search",
			"readOnly": true,
			"network": "declared public provider",
			"credentials": "none",
			"externalSideEffects": []
		},
		{
			"id": "browser",
			"readOnly": true,
			"network": "host-approved navigation target",
			"credentials": "optional browser-session",
			"externalSideEffects": ["browser-navigation"]
		}
	]
}
